{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist-test",
    "declaration": false,
    "incremental": false
  },
  "include": [
    "src/**/*.ts",
    "test/integration/**/*.ts",
    "test/e2e/**/*.ts",
    "test/contract/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "dist-test", "src/**/*.spec.ts"]
}
