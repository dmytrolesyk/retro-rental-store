Project RetroGamesRental {
  database_type: 'PostgreSQL'
  Note: 'Database schema for a retro games rental shop'
}

enum game_condition {
  as_new
  good
  poor
}

enum physical_format {
  cartridge
  optical_disc
  floppy_disc
  tape
}

enum game_data_source {
  retronian
  synthetic
  manual
}

Table games {
  game_id uuid [pk, default: `gen_random_uuid()`]
  game_cover_url text
  name varchar(120) [not null]
  name_uk varchar(120) [not null]
  description text [not null]
  description_uk text [not null]
  release_date date
  data_source game_data_source [not null, default: 'manual']
  search_vector tsvector [not null, note: '''
    Stored generated column:
    setweight(to_tsvector('simple', name_uk), 'A') ||
    setweight(to_tsvector('simple', description_uk), 'B')
  ''']
}

Table platforms {
  platform_id uuid [pk, default: `gen_random_uuid()`]
  name varchar(120) [not null, unique]
  description text [not null]
  description_uk text [not null]
  release_date date [not null]
}

Table game_platforms {
  game_id uuid [not null, ref: > games.game_id]
  platform_id uuid [not null, ref: > platforms.platform_id]

  indexes {
    (game_id, platform_id) [pk]
  }
}

Table game_copies {
  game_copy_id uuid [pk, default: `gen_random_uuid()`]
  game_id uuid [not null, ref: > games.game_id]
  platform_id uuid [not null, ref: > platforms.platform_id]
  photo_url text
  condition game_condition [not null]
  format physical_format [not null]
  price_per_day numeric(10,2) [not null]

  checks {
    `price_per_day >= 0` [name: 'non_negative_price']
  }
}

Table genres {
  genre_id uuid [pk, default: `gen_random_uuid()`]
  name varchar(120) [not null, unique]
  description text
}

Table game_genres {
  game_id uuid [not null, ref: > games.game_id]
  genre_id uuid [not null, ref: > genres.genre_id]

  indexes {
    (game_id, genre_id) [pk]
  }
}

Table renters {
  renter_id uuid [pk, default: `gen_random_uuid()`]
  name varchar(80) [not null]
  email varchar(120) [not null, unique]
  phone_number varchar [not null, unique]
}

Table rentals {
  rental_id uuid [pk, default: `gen_random_uuid()`]
  renter_id uuid [not null, ref: > renters.renter_id]
  rented_at timestamptz [not null]
}

Table rental_items {
  rental_id uuid [not null, ref: > rentals.rental_id]
  game_copy_id uuid [not null, ref: > game_copies.game_copy_id, note: '''
    The partial unique index one_active_rental_per_copy is defined in
    db/indexes.sql so a physical copy can have at most one active rental.
    ''']
  returned_at timestamptz [note: '''
    A trigger in db/schema.sql ensures returned_at is not earlier than rented_at.
  ''']
  cost_per_day numeric(10,2) [not null]

  checks {
    `cost_per_day >= 0` [name: 'non_negative_cost']
  }

  indexes {
    (rental_id, game_copy_id) [pk]
  }
}
