# Compose provisioning: role-specific local development settings
DB_ADMIN_USER=db_admin
DB_ADMIN_PASSWORD=admin_dev
DB_MIGRATION_USER=db_migrator
DB_MIGRATION_PASSWORD=migration_dev
DB_APP_USER=db_app
DB_APP_PASSWORD_FILE=/run/secrets/db_app_password

# Connection settings for this process (API example, inside Compose)
DB_HOST=db
DB_PORT=5432
DB_USER=db_app
DB_NAME=rental
DB_PASSWORD_FILE=/run/secrets/db_app_password
# CLI instead uses DB_USER=db_migrator and DB_PASSWORD=migration_dev.
# Set exactly one of DB_PASSWORD and DB_PASSWORD_FILE.
# DB_PORT also selects the host port published by Compose.

PORT=3000
LOG_LEVEL=info
TIMEOUT_MS=5000
