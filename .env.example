# Compose provisioning: role-specific local development settings
DB_ADMIN_USER=db_admin
DB_ADMIN_PASSWORD=admin_dev
DB_MIGRATION_USER=db_migrator
DB_MIGRATION_PASSWORD=migration_dev
DB_APP_USER=db_app
DB_APP_PASSWORD_FILE=/run/secrets/db_app_password

# Connection settings for this process (API example, inside Compose)
DB_HOST=pgbouncer
DB_PORT=6432
DB_USER=db_app
DB_NAME=rental
DB_PASSWORD_FILE=/run/secrets/db_app_password
# CLI instead uses DB_USER=db_migrator and DB_PASSWORD=migration_dev.
# Set exactly one of DB_PASSWORD and DB_PASSWORD_FILE.
# Host-side connection contract only; this password is deliberately fake.
DATABASE_URL=postgres://db_app:fake_password@127.0.0.1:6432/rental
# Backup processes need a separate environment with a readable role and direct PostgreSQL:
# DATABASE_URL=postgresql://db_migrator:migration_dev@127.0.0.1:5432/rental
# Compose host port overrides: PGBOUNCER_PORT for PgBouncer, POSTGRES_PORT for direct PostgreSQL.
PGBOUNCER_PORT=6432
POSTGRES_PORT=5432

PORT=3000
LOG_LEVEL=info
TIMEOUT_MS=5000

# Optional Resend settings (start:worker and demo:email; not required by the API or offline demos).
# Supply RESEND_API_KEY through your local environment; do not commit a real key.
# RESEND_API_KEY=
# EMAIL_FROM=Retro Games Rental <notifications@send.your-domain.dev>
# DEMO_EMAIL_TO=delivered@resend.dev

# Optional contract profile: docker compose --profile contract up -d --wait pact-broker
PACT_BROKER_PORT=9292
# Export only for Broker mode; leave unset for local-file provider verification.
# PACT_BROKER_URL=http://127.0.0.1:9292
# PACT_BROKER_TOKEN=  # inject through environment/with-secrets, never commit
# CONSUMER_VERSION / PROVIDER_VERSION default to the current Git commit SHA.
