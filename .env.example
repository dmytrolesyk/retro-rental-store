# HTTP port the API listens on
PORT=3000
# Postgres host (service name inside docker compose; use 127.0.0.1 for local runs against the compose db)
PG_HOST=db
# Postgres port
PG_PORT=5432
# Application database role (least-privilege user, not the admin)
PG_USER=app_user
# Database name
PG_DB=rental
# Path to the file holding the app user's password (docker secret in containers; generated by scripts/bootstrap.sh)
PG_PASSWORD_FILE=secrets/app_pg_password
# Log verbosity: debug | info | warn | error
LOG_LEVEL=info
# Generic operation timeout, milliseconds
TIMEOUT_MS=5000
