{
  "name": "retro-games-rental",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "pnpm check:env && nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:lms": "eslint \"tools/lms-client/src/**/*.ts\" \"tools/lms-client/test/**/*.mjs\" --max-warnings=0",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:db:transactions": "pnpm run build && node --test test/transactions-schema.integration.mjs",
    "test:db:checkout": "pnpm run build && node --test test/checkout.integration.mjs",
    "test:db:race": "pnpm run build && node --test test/race.integration.mjs",
    "check:env": "pnpm run build && node scripts/check-env-example.mjs",
    "compose:up": "docker compose up -d --build --wait",
    "compose:down": "docker compose down",
    "migrate": "typeorm migration:run -d dist/data-source.js",
    "migrate:show": "typeorm migration:show -d dist/data-source.js",
    "migrate:revert": "typeorm migration:revert -d dist/data-source.js",
    "migration:generate": "typeorm migration:generate -d dist/data-source.js",
    "seed": "node dist/scripts/seed.js",
    "demo:nplus1": "node dist/scripts/demo-nplus1.js",
    "demo:race": "bash scripts/with-secrets.sh dev node dist/scripts/demo-race.js",
    "report": "node dist/scripts/report.js",
    "course:init": "git submodule update --init --recursive reference/node-js-pro",
    "course:update": "git submodule update --init --remote reference/node-js-pro",
    "course:diff": "git diff --submodule -- reference/node-js-pro",
    "demo:workers": "bash scripts/with-secrets.sh dev node dist/scripts/demo-workers.js",
    "test:db:workers": "pnpm run build && node --test test/workers.integration.mjs",
    "start:worker": "node dist/worker/main.js",
    "demo:email": "node dist/scripts/demo-email.js",
    "demo:retry": "bash scripts/with-secrets.sh dev node dist/scripts/demo-retry.js",
    "test:db:retry": "pnpm run build && node --test test/retry.integration.mjs",
    "test:secrets": "node --test test/with-secrets.test.mjs",
    "test:db:pooler": "pnpm run build && node --test test/pgbouncer.integration.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/typeorm": "12.0.2",
    "csv-parse": "^7.0.3",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.33.0",
    "rxjs": "^7.8.2",
    "typeorm": "0.3.31",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "packageManager": "pnpm@10.24.0"
}
